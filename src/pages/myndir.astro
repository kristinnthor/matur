---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { photoFor } from '../lib/photos';

const recipes = await getCollection('recipes');
const manifest = recipes
  .map((r) => ({ slug: r.id, title: r.data.title, hasPhoto: Boolean(photoFor(r.id)) }))
  .sort((a, b) => Number(a.hasPhoto) - Number(b.hasPhoto) || a.title.localeCompare(b.title, 'is'));
---
<Base title="Myndir — Matur">
  <meta name="robots" content="noindex" slot="head" />
  <div class="wrap upload-page">
    <h1>Myndir</h1>
    <p class="tagline muted">
      Taktu mynd af réttinum og hladdu henni upp — hún fer sjálfkrafa í loftið á um tveimur mínútum.
    </p>

    <p id="upload-signin" class="muted" hidden>
      Skráðu þig inn efst á síðunni til að hlaða upp mynd.
    </p>

    <form id="upload-form" hidden>
      <label class="field">
        <span>Uppskrift</span>
        <select id="recipe-select" required>
          <option value="" disabled selected>Veldu uppskrift…</option>
          <optgroup label="Vantar mynd">
            {manifest.filter((m) => !m.hasPhoto).map((m) => <option value={m.slug}>{m.title}</option>)}
          </optgroup>
          <optgroup label="Með mynd — verður skipt út">
            {manifest.filter((m) => m.hasPhoto).map((m) => <option value={m.slug}>{m.title}</option>)}
          </optgroup>
        </select>
      </label>

      <label class="field">
        <span>Mynd</span>
        <input type="file" id="photo-input" accept="image/*" capture="environment" required />
      </label>

      <div id="preview-crop"></div>

      <button type="submit" id="upload-btn" class="cook-link">Hlaða upp</button>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </div>

  <script>
    import '../scripts/myndir.ts';
  </script>
</Base>
