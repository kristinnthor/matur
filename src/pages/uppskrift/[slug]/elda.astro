---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { renderStepHtml } from '../../../lib/steps';
import { skammtar, type Ingredient } from '../../../lib/units';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((r) => ({ params: { slug: r.id }, props: { recipe: r } }));
}

const { recipe } = Astro.props;
const d = recipe.data;
const ings = d.ingredients as Ingredient[];
---
<Base title={`${d.title} — elda`} showHeader={false}>
  <main class="cook" data-slug={recipe.id} data-base={d.servings}>
    <header>
      <a href={`/uppskrift/${recipe.id}/`}>← Til baka</a>
      <span class="counter muted" id="cook-servings">{d.servings} {skammtar(d.servings)}</span>
      <span class="counter"><span id="current">1</span> / {d.steps.length}</span>
    </header>

    {d.steps.map((s: { text: string }, i: number) => (
      <section class="step" data-index={i} data-template={s.text} hidden={i !== 0}>
        <p set:html={renderStepHtml(s.text, ings, 1)} />
      </section>
    ))}

    <nav class="cook-nav">
      <button type="button" id="prev">Fyrra</button>
      <button type="button" id="next">Næsta</button>
    </nav>
  </main>

  <script type="application/json" id="cook-ingredients" set:html={JSON.stringify(ings).replaceAll('<', '\\u003c')} />
  <script>
    import '../../../scripts/cook.ts';
  </script>
</Base>
