---
import { Image } from 'astro:assets';
import { photoFor } from '../lib/photos';
import { skammtar } from '../lib/units';

const { recipe } = Astro.props;
const d = recipe.data;
const total = d.time.prep + d.time.cook;
const initial = d.title.charAt(0);
const photo = photoFor(recipe.id);
---
<a class="card" href={`/uppskrift/${recipe.id}/`}>
  {photo
    ? <Image src={photo} alt="" widths={[400, 800]} sizes="(max-width: 40rem) 92vw, 400px" />
    : (
      <div class="card-ph" aria-hidden="true">
        <span>{initial}</span>
        {/* Only shown to signed-in family members — see .needs-photo. A visitor
            does not need telling that the site is unfinished, and only someone
            signed in can do anything about it. */}
        <em class="needs-photo">Vantar mynd</em>
      </div>
    )}
  <div class="body">
    <h2 class="card-title">{d.title}</h2>
    <p class="muted">{d.subtitle ?? d.description.slice(0, 90)}</p>
    <p class="meta muted">{total} mín · {d.servings} {skammtar(d.servings)}</p>
  </div>
</a>
