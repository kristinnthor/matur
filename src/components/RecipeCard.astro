---
import { Image } from 'astro:assets';

const { recipe } = Astro.props;
const d = recipe.data;
const total = d.time.prep + d.time.cook;
const initial = d.title.charAt(0);
---
<a class="card" href={`/uppskrift/${recipe.id}/`}>
  {d.image
    ? <Image src={d.image} alt="" widths={[400, 800]} sizes="(max-width: 40rem) 92vw, 400px" />
    : <div class="card-ph" aria-hidden="true"><span>{initial}</span></div>}
  <div class="body">
    <h3>{d.title}</h3>
    <p class="muted">{d.subtitle ?? d.description.slice(0, 90)}</p>
    <p class="meta muted">{total} mín · {d.servings} skammtar</p>
  </div>
</a>
