---
import { Image } from 'astro:assets';
import { formatScaled, skammtar, type Ingredient } from '../lib/units';
import { renderStepHtml } from '../lib/steps';
import { creditFor, photoFor } from '../lib/photos';
import { TAGS } from '../lib/taxonomy';

const { recipe } = Astro.props;
const d = recipe.data;
const ings = d.ingredients as Ingredient[];
const total = d.time.prep + d.time.cook;

// Preserve authored order; an ungrouped recipe collapses to a single unnamed group.
const groups: { name: string; items: Ingredient[] }[] = [];
for (const i of ings) {
  const name = i.group ?? '';
  const last = groups[groups.length - 1];
  if (last && last.name === name) last.items.push(i);
  else groups.push({ name, items: [i] });
}

const photo = photoFor(recipe.id);
const credit = creditFor(recipe.id);
---
<article class="wrap">
  <header class="recipe-head">
    <h1>{d.title}</h1>
    {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
    <p class="lead">{d.description}</p>
    <p class="meta muted"><b>{total} mín</b> · undirbúningur {d.time.prep} mín · eldun {d.time.cook} mín · {d.servings} {skammtar(d.servings)}</p>
    {d.tags.length > 0 && (
      <p class="tag-row">
        {d.tags.map((t: string) => (
          <a class="tag-chip" href={`/merki/${t}/`}>{TAGS[t as keyof typeof TAGS]}</a>
        ))}
      </p>
    )}
    {photo ? (
      <figure class="photo-wrap">
        <Image
          src={photo}
          alt={d.title}
          widths={[720, 1280, 1600]}
          sizes="(max-width: 72rem) 100vw, 1120px"
          loading="eager"
          class="recipe-hero"
        />
        <button type="button" id="photo-edit-open" class="photo-edit-btn" data-slug={recipe.id} aria-label="Skipta um mynd">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </button>
        {credit && (
          <figcaption class="photo-credit">
            Mynd: <a href={credit.sourceUrl} rel="noopener nofollow">{credit.creator}</a>
            {' · '}
            <a href={credit.licenseUrl} rel="license noopener nofollow">{credit.license}</a>
          </figcaption>
        )}
      </figure>
    ) : (
      <button type="button" id="photo-edit-open" class="photo-add" data-slug={recipe.id}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        Bæta við mynd
      </button>
    )}

    <dialog id="photo-dialog" aria-labelledby="photo-dialog-title">
      <h2 id="photo-dialog-title">Mynd af réttinum</h2>
      <div id="photo-dialog-crop"></div>
      <label class="field">
        <span>Leyninúmer</span>
        <input type="password" id="photo-dialog-pass" autocomplete="current-password" />
      </label>
      <div class="dialog-actions">
        <button type="button" id="photo-dialog-cancel">Hætta við</button>
        <button type="button" id="photo-dialog-submit" class="primary">Hlaða upp</button>
      </div>
      <p id="photo-dialog-status" role="status" aria-live="polite"></p>
    </dialog>

    {/* Favourite + private note. Filled in by recipe-personal.ts only when
        someone is signed in; empty and hidden for everyone else. */}
    <div id="recipe-personal" class="recipe-personal" data-slug={recipe.id} hidden></div>
  </header>

  <div class="recipe-grid">
    <aside>
      <div class="scaler">
        <label for="servings">Skammtar</label>
        <button type="button" data-step="-1" aria-label="Fækka skömmtum">−</button>
        <output id="servings" data-base={d.servings}>{d.servings}</output>
        <button type="button" data-step="1" aria-label="Fjölga skömmtum">+</button>
      </div>

      <h2>Hráefni</h2>
      {groups.map((g) => (
        <>
          {g.name && <h3 class="ing-group">{g.name}</h3>}
          <ul class="ingredients">
            {g.items.map((i) => (
              <li>
                <input type="checkbox" id={`ing-${i.id}`} />
                <label for={`ing-${i.id}`}>
                  <span
                    class="qty"
                    data-id={i.id}
                    data-amount={i.amount}
                    data-unit={i.unit}
                    data-item={i.item}
                    data-scalable={String(i.scalable ?? true)}
                  >{formatScaled(i, 1)}</span>
                  <span class="ing-name">{i.item}{i.note && <span class="muted">, {i.note}</span>}</span>
                </label>
              </li>
            ))}
          </ul>
        </>
      ))}
    </aside>

    <div>
      <h2>Aðferð</h2>
      <ol class="steps">
        {d.steps.map((s: { text: string; refs: string[] }) => (
          <li data-template={s.text} set:html={renderStepHtml(s.text, ings, 1)} />
        ))}
      </ol>

      {(d.notes.improvements || d.notes.storage || d.notes.variants) && (
        <section class="notes">
          <h2>Athugasemdir</h2>
          {d.notes.improvements && <p><span class="note-label">Endurbætur:</span> {d.notes.improvements.replace(/^Endurbætur frá upprunalegu uppskriftinni:\s*/, '')}</p>}
          {d.notes.storage && <p><span class="note-label">Geymsla:</span> {d.notes.storage}</p>}
          {d.notes.variants && <p><span class="note-label">Tilbrigði:</span> {d.notes.variants}</p>}
        </section>
      )}

      <p class="source muted">
        Byggt á uppskrift frá <a href={d.source.url} rel="noopener nofollow">{d.source.site}</a>
      </p>

      <div class="recipe-actions">
        <a class="cook-link" href={`/uppskrift/${recipe.id}/elda/`}>Byrja að elda</a>
        <button type="button" id="add-to-list" class="list-btn" data-slug={recipe.id} data-servings={d.servings}>Setja á innkaupalista</button>
      </div>
    </div>
  </div>
</article>

<script>
  import '../scripts/scaler.ts';
  import '../scripts/add-to-list.ts';
  import '../scripts/photo-edit.ts';
  import '../scripts/recipe-personal.ts';
</script>
