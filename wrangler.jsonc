{
  "name": "matur",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  // Gate + build: typecheck, unit tests and the recipe lint all run before
  // every deploy (including Cloudflare CI, where the dashboard build command
  // is intentionally empty) - a red test now blocks the deploy.
  "build": { "command": "npm run verify" },
  // Static Astro output served as assets; worker/index.ts fronts /api/* and
  // falls through to assets for everything else.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": { "GITHUB_REPO": "kristinnthor/matur" },
  // Personal data (favourites, private notes) for signed-in family members.
  // Deliberately left commented out: a binding with a database_id that does not
  // exist fails the real deploy (dry-run does not catch it), which would take
  // the whole site down for a feature nobody has turned on yet.
  //
  // To enable, run `npx wrangler d1 create matur`, then uncomment this with the
  // database_id it prints and apply worker/schema.sql. Until then the account
  // endpoints answer 503 and the site behaves exactly as before.
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "matur", "database_id": "<id>" }
  // ]
}
